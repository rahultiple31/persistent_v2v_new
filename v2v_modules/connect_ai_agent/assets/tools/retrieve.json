      "errors": {
        "items": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "description": "The error code categorizing the failure. . Error code returned for a failed assistant association during multi-association Retrieve.",
              "enum": [
                "INTERNAL_SERVER_ERROR",
                "ACCESS_DENIED",
                "RESOURCE_NOT_FOUND",
                "DEPENDENCY_FAILED",
                "THROTTLED",
                "VALIDATION_ERROR"
              ]
            },
            "message": {
              "type": "string",
              "description": "A human-readable description of the failure."
            },
            "associationId": {
              "type": "string",
              "description": "The assistant association ID for which the retrieval failed."
            }
          },
          "required": [
            "associationId",
            "code",
            "message"
          ],
          "description": "An error returned for an individual assistant association during a multi-association Retrieve. The overall request may still succeed with results from other associations.",
