  "title": "aws_service__qconnect_Retrieve",
  "toolId": "aws_service__qconnect_Retrieve",
  "description": "Searches the knowledge base to return relevant knowledge article excerpts.",
  "instruction": {
    "instruction": "Use only for a finalized support need when the orchestration prompt permits retrieval.\nNever retrieve for greetings, silence, yes/no answers, UPI availability, UPI capture,\nUPI readback confirmation, or first-name verification. A clear Yes to UPI availability\nmust continue to UPI capture without retrieval. Retrieval failure never authorizes\nComplete or Escalate; follow the prompt's failure handling.",
    "examples": []
  },
